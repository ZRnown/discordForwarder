#############################################
# Discord → Discord（Webhook）配置样例        #
#############################################

# 后端类型：默认使用 selfbot。只有在你配置了常规 Discord 机器人应用时才使用 bot。
# 默认：selfbot
# DISCORD_BOT_BACKEND=bot
DISCORD_BOT_BACKEND=selfbot

# 必填：你的 Discord 令牌（selfbot 或 bot）
DISCORD_TOKEN=ODc2NDUyNzE4NzgzMzk3ODkw.GSGbwI.WWwMqxHMCnaghDxyBCWrB8eejD2Db7cH-ZvTY0

# 必填：目标 Discord Webhook 地址（消息将被转发到这里）
# 在目标频道创建一个 Webhook，并把其完整 URL 粘贴到这里
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1439851822658486313/z_unIAB5BnbXTdCVSHL49JaNx0RoiET--RpUusVyFf51Mn_11qjcTSIHcVz4hI7VyygV

# 可选：为 Discord 连接设置 HTTP/SOCKS 代理
# 示例：http://username:password@proxy.example.com:8080
PROXY_URL="http://127.0.0.1:7897"

# 可选：生产模式（Docker/服务器环境）
# NODE_ENV=production
TRANSLATION_ENABLED=true
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 可选
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions