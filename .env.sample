#############################################
# Discord → Discord（Webhook）环境变量样例    #
#############################################

# 必填：你的 Discord 令牌（selfbot）
DISCORD_TOKEN=xxxxx

# 翻译开关（默认 true）
TRANSLATION_ENABLED=true

# DeepSeek API（可选：仅在启用翻译且希望自动追加中文译文时需要）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# 控制台日志级别：error | info | debug
LOG_LEVEL=error

# 文件日志级别：未设置时会回退到 LOG_LEVEL，输出到 ./log/YYYY-MM-DD/*.log
LOG_FILE_LEVEL=error

# 可选：覆盖 config.json 的 logging.keepDays；默认就是 1 天
LOG_KEEP_DAYS=1

# 是否在启动后向默认 webhook 发送“已启动”通知
SEND_STARTUP_NOTIFICATION=false

# Token 检查间隔（分钟）
# 代码里会强制最小值为 5
TOKEN_CHECK_INTERVAL_MINUTES=60

# 邮件告警（Token 失效 / 过期时使用）
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=bot@example.com
EMAIL_SMTP_PASS=change-me
EMAIL_FROM=bot@example.com
EMAIL_TO=ops@example.com
